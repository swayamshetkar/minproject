# Rules-only mode requires no key and is the default.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_LENGTH=5000
AI_MAX_RESPONSE_TOKENS=1024

# Render injects PORT; bind all interfaces there. Local uvicorn can use this too.
HOST=0.0.0.0
PORT=8000
# Set to your deployed frontend origin(s), comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_SIZE=10000
LOG_LEVEL=INFO
LOG_MESSAGES=false
